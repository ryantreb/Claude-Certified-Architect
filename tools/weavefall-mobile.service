# Weavefall mobile build — static server for the tailnet (systemd user unit).
#
# Serves the generated mobile/ folder on 127.0.0.1:8753. Loopback-only on
# purpose: the LAN can never reach it; `tailscale serve` proxies it out to the
# tailnet with HTTPS. Install per docs/phone-runbook.md:
#
#   mkdir -p ~/.config/systemd/user
#   cp tools/weavefall-mobile.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now weavefall-mobile
#   loginctl enable-linger "$USER"     # keep it running when logged out
#
# If the repo lives somewhere other than ~/Claude-Certified-Architect, edit
# WorkingDirectory before installing.

[Unit]
Description=Weavefall mobile build static server (tailnet-only)
After=network.target

[Service]
WorkingDirectory=%h/Claude-Certified-Architect/mobile
ExecStart=/usr/bin/python3 -m http.server 8753 --bind 127.0.0.1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
